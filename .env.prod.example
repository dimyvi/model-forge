# Copy to .env on the production VM and fill in both empty secrets.
POSTGRES_DB=model_forge
POSTGRES_USER=model_forge
POSTGRES_PASSWORD=

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=model-forge.ru,www.model-forge.ru,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://model-forge.ru,https://www.model-forge.ru

# Optional until outbound email is implemented. Set real SMTP values before use.
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=0

ML_TRAINING_TIMEOUT=300
ML_WORKER_POLL_INTERVAL=2
